@* A declension table: cases down, masculine / neuter / feminine / plural across. One cell can be highlighted; cells
   where the adjective carries the signal are marked. *@
<table class="decl">
    <thead><tr><th></th><th>m</th><th>n</th><th>f</th><th>Pl</th></tr></thead>
    <tbody>
        @foreach (var @case in Enum.GetValues<Case>())
        {
            <tr>
                <th scope="row">@Short(@case)</th>
                @foreach (var column in Enum.GetValues<GenderNumber>())
                {
                    <td class="@(Highlight == (@case, column) ? "hl" : Table.ShowsSignal(@case, column) ? "sg" : "")">@(Table[@case, column] ?? "–")</td>
                }
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired] public Paradigm Table { get; set; } = null!;
    [Parameter] public (Case, GenderNumber)? Highlight { get; set; }

    private static string Short(Case @case) => German.Case(@case)[..3];
}
