@page "/ueben"
@inject Catalog Catalog
@inject ProgressService Learner
@inject TimeProvider Clock
@inject Random Random

<TopBar Title="Üben" Back="">
    @if (attempt is not null)
    {
        <span class="counter" aria-label="@session!.Answered von @session.Total Karten geübt">@session.Answered / @session.Total</span>
    }
</TopBar>

@if (attempt is null)
{
    <div class="card">
        <p class="headline">@(session?.Total > 0 ? "Geschafft" : "Für heute ist alles geübt")</p>
        @if (session?.Total > 0)
        {
            <p>@session.RightFirstTime von @session.Total Karten beim ersten Versuch richtig.</p>
        }
    </div>
    @if (more)
    {
        <button class="btn primary" @onclick="Start">Weiter üben</button>
    }
    <a class="btn" href="">Zur Übersicht</a>
}
else
{
    <div class="meta"><span class="chip">@Label(attempt.Exercise)</span></div>

    @switch (attempt.Exercise)
    {
        case ArticleExercise e:
            <ArticleTask Exercise="e" Done="attempt.IsDone" Wrong="attempt.Wrong" OnSubmit="Submit" />
            break;
        case CaseExercise e:
            <CaseTask Exercise="e" Done="attempt.IsDone" Wrong="attempt.Wrong" OnSubmit="Submit" />
            break;
        case EndingExercise e:
            <EndingTask Exercise="e" Done="attempt.IsDone" Wrong="attempt.Wrong" OnSubmit="Submit" />
            break;
        case WhoWhomExercise e:
            <WhoWhomTask Exercise="e" Done="attempt.IsDone" Wrong="attempt.Wrong" OnSubmit="Submit" />
            break;
        case RektionExercise e:
            <RektionTask Exercise="e" Done="attempt.IsDone" Wrong="attempt.Wrong" OnSubmit="Submit" OnGiveUp="GiveUp" />
            break;
    }

    @if (attempt.AwaitsRetry)
    {
        <div class="card hint-card" role="status"><b>Noch nicht.</b> @attempt.Hint</div>
    }
    @if (attempt.Rating is { } rating)
    {
        <div class="result" role="status">
            <span class="tag @(rating == Rating.Again ? "bad" : "ok")">@Verdict(rating)</span>
            @if (rating == Rating.Again)
            {
                <span class="muted">Kommt in dieser Runde noch einmal.</span>
            }
        </div>
        <button class="btn next" @onclick="Next">Weiter <Icon Name="arrow-right" /></button>
    }
}

@code {
    private Session? session;
    private Attempt? attempt;
    private bool more;

    private static string Verdict(Rating rating) => rating switch
    {
        Rating.Good => "Richtig",
        Rating.Hard => "Richtig im zweiten Versuch",
        _ => "Nicht richtig",
    };

    protected override void OnInitialized() => Start();

    private void Start()
    {
        session = Learner.StartSession(Clock.Today(), Random);
        Show();
    }

    private void Show()
    {
        attempt = session!.Current is { } card ? new Attempt(Catalog.Exercise(card, Random)) : null;
        // More due or new cards than fit into one session.
        if (attempt is null) more = Learner.NextSessionSize(Clock.Today()) > 0;
    }

    // The answer is recorded (and saved) right away, so closing the app on the feedback screen loses nothing.
    private void Submit(string answer)
    {
        if (attempt!.Submit(answer) is { } rating) session!.Answer(rating);
    }

    private void GiveUp() => session!.Answer(attempt!.GiveUp());

    private void Next() => Show();

    private static string Label(Exercise exercise) => exercise switch
    {
        ArticleExercise e => $"Artikel · {e.Noun.Level}",
        CaseExercise e => $"Fälle · {German.Case(e.Frame.Case)}",
        WhoWhomExercise => "Fälle · Wer macht was?",
        EndingExercise e => $"Adjektiv · {German.Case(e.Frame.Case)}",
        RektionExercise e => $"Rektion · {e.Entry.Level}",
        _ => "",
    };
}
